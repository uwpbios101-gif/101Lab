<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Osmosis & Tonicity Lab</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;600&display=swap');

    :root {
      --black: #0f0f0f;
      --gold: #F5A800;
      --gold-lt: #FFC94D;
      --gold-dim: #a37000;
      --white: #fff;
      --gray1: #f0ede8;
      --gray2: #ddd9d2;
      --blue: #1a4e8c;
      --brown: #7a3b0a;
      --green: #1b6b2f;
      --green-lt: #2d9e47;
      --red: #c0392b;
      --water: #c8e6f7;
      --panel-bg: #181818;
      --panel-border: #2a2a2a;
      --step-active: #F5A800;
      --step-done: #2d9e47;
      --step-todo: #2a2a2a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Space Grotesk', sans-serif;
      background: var(--gray1);
      color: var(--black);
      overflow-x: hidden;
    }

    /* ═══════════════════════════════════════
   HEADER
═══════════════════════════════════════ */
    .hdr {
      background: var(--black);
      border-bottom: 3px solid var(--gold);
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.4rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .hdr-left {
      display: flex;
      align-items: center;
      gap: .7rem;
    }

    .hdr-badge {
      background: var(--gold);
      color: var(--black);
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: .72rem;
      padding: 3px 10px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .hdr-title {
      color: #ccc;
      font-size: .8rem;
      letter-spacing: .06em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .hdr-score {
      color: #aaa;
      font-size: .8rem;
      font-family: 'JetBrains Mono', monospace;
    }

    /* ═══════════════════════════════════════
   PHASE TRACKER (top nav)
═══════════════════════════════════════ */
    .phase-bar {
      background: #141414;
      border-bottom: 1px solid #222;
      padding: .6rem 1.4rem;
      display: flex;
      align-items: center;
      gap: .5rem;
      flex-wrap: wrap;
    }

    .phase-label {
      color: var(--gold);
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      margin-right: .3rem;
    }

    .phase-step {
      display: flex;
      align-items: center;
      gap: .3rem;
      background: #1e1e1e;
      border: 1.5px solid #333;
      padding: .28rem .7rem;
      cursor: pointer;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: #555;
      transition: all .2s;
      position: relative;
    }

    .phase-step.active {
      background: var(--gold);
      color: var(--black);
      border-color: var(--gold);
    }

    .phase-step.done {
      background: #0d2010;
      color: var(--step-done);
      border-color: var(--step-done);
    }

    .phase-step .ps-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: .75rem;
      font-weight: 700;
    }

    .phase-sep {
      color: #333;
      font-size: .9rem;
    }

    /* ═══════════════════════════════════════
   PRE-LAB TEACHING SCREEN
═══════════════════════════════════════ */
    #prelabScreen {
      display: flex;
      min-height: calc(100vh - 97px);
    }

    .prelab-sidebar {
      width: 260px;
      min-width: 260px;
      background: var(--black);
      border-right: 1px solid #222;
      padding: 1.2rem 0;
      position: sticky;
      top: 97px;
      height: calc(100vh - 97px);
      overflow-y: auto;
    }

    .sidebar-title {
      font-size: .62rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #555;
      padding: 0 1.2rem .8rem;
      border-bottom: 1px solid #1e1e1e;
      margin-bottom: .6rem;
    }

    .sb-item {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .6rem 1.2rem;
      cursor: pointer;
      transition: background .15s;
      border-left: 3px solid transparent;
    }

    .sb-item:hover {
      background: #151515;
    }

    .sb-item.active {
      border-left-color: var(--gold);
      background: #151515;
    }

    .sb-item.done {
      border-left-color: var(--step-done);
    }

    .sb-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #1e1e1e;
      border: 2px solid #333;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: .75rem;
      font-weight: 700;
      color: #555;
      flex-shrink: 0;
      transition: all .2s;
    }

    .sb-item.active .sb-num {
      background: var(--gold);
      border-color: var(--gold);
      color: var(--black);
    }

    .sb-item.done .sb-num {
      background: var(--step-done);
      border-color: var(--step-done);
      color: #fff;
    }

    .sb-text {
      font-size: .8rem;
      color: #777;
      font-weight: 500;
      line-height: 1.3;
    }

    .sb-item.active .sb-text {
      color: #eee;
    }

    .sb-item.done .sb-text {
      color: #4caf50;
    }

    .prelab-content {
      flex: 1;
      padding: 2rem 2.5rem;
      overflow-y: auto;
      max-width: 820px;
    }

    /* Teaching card */
    .teach-card {
      display: none;
      animation: fadeSlideIn .35s ease;
    }

    .teach-card.active {
      display: block;
    }

    @keyframes fadeSlideIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .step-eyebrow {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .4rem;
    }

    .step-heading {
      font-family: 'Open Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.25;
      color: var(--black);
      margin-bottom: 1rem;
    }

    .step-body {
      font-size: .95rem;
      line-height: 1.7;
      color: #000000;
      margin-bottom: 1.4rem;
    }

    .step-body strong {
      color: var(--black);
    }

    /* Concept box */
    .concept-box {
      background: var(--black);
      color: #eee;
      border-left: 4px solid var(--gold);
      padding: 1rem 1.3rem;
      margin-bottom: 1.4rem;
      font-size: .88rem;
      line-height: 1.6;
    }

    .concept-box .cb-title {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .5rem;
    }

    .concept-box strong {
      color: var(--gold-lt);
    }

    /* Draw box — ADHD pen-and-paper instruction */
    .draw-box {
      background: #fffbf0;
      border: 2px dashed #d4a017;
      padding: 1.1rem 1.3rem;
      margin-bottom: 1.4rem;
    }

    .draw-box .db-title {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: .6rem;
      display: flex;
      align-items: center;
      gap: .4rem;
    }

    .draw-box .db-steps {
      list-style: none;
      counter-reset: draw-counter;
    }

    .draw-box .db-steps li {
      counter-increment: draw-counter;
      display: flex;
      gap: .7rem;
      align-items: flex-start;
      font-size: .87rem;
      line-height: 1.5;
      color: #000000;
      padding: .25rem 0;
    }

    .draw-box .db-steps li::before {
      content: counter(draw-counter);
      background: #d4a017;
      color: white;
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      font-weight: 700;
      min-width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* Equation display */
    .eq-display {
      background: #f8f8f8;
      border: 1px solid var(--gray2);
      padding: 1.1rem 1.4rem;
      margin-bottom: 1.4rem;
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
    }

    .eq-part {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.05rem;
      font-weight: 600;
    }

    .eq-plus {
      color: #999;
      font-size: 1.2rem;
    }

    .eq-eq {
      color: #999;
      font-size: 1.2rem;
    }

    .eq-solute {
      color: var(--brown);
    }

    .eq-solvent {
      color: var(--blue);
    }

    .eq-result {
      color: var(--green);
    }

    /* Prefix table */
    .prefix-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.4rem;
    }

    .prefix-table th {
      background: var(--black);
      color: var(--gold);
      font-size: .7rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .55rem .8rem;
      text-align: left;
      font-weight: 700;
    }

    .prefix-table td {
      padding: .6rem .8rem;
      font-size: .88rem;
      border-bottom: 1px solid var(--gray2);
    }

    .prefix-table tr:nth-child(even) td {
      background: #f8f6f2;
    }

    .prefix-table .pref {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1rem;
      font-weight: 700;
    }

    .prefix-table .hypo {
      color: var(--blue);
    }

    .prefix-table .hyper {
      color: var(--red);
    }

    .prefix-table .iso {
      color: var(--green);
    }

    /* Mini beaker diagrams for teaching */
    .mini-beakers {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.4rem;
    }

    .mini-beaker {
      flex: 1;
      min-width: 160px;
      background: #fff;
      border: 1.5px solid var(--gray2);
      padding: .9rem;
      text-align: center;
    }

    .mini-beaker svg {
      width: 100%;
      height: 120px;
    }

    .mini-b-label {
      font-size: .78rem;
      font-weight: 700;
      margin-top: .5rem;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .mini-b-sub {
      font-size: .72rem;
      color: #666;
      margin-top: .15rem;
    }

    /* Memory anchor */
    .memory-anchor {
      background: #fff8e1;
      border: 2px solid #f5a800;
      padding: .9rem 1.2rem;
      margin-bottom: 1.4rem;
      display: flex;
      gap: .8rem;
      align-items: flex-start;
    }

    .ma-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .ma-text {
      font-size: .87rem;
      line-height: 1.55;
      color: #000000;
    }

    .ma-text strong {
      color: var(--black);
    }

    /* Check-yourself quiz within pre-lab */
    .check-quiz {
      background: var(--black);
      padding: 1.2rem 1.4rem;
      margin-bottom: 1.4rem;
    }

    .cq-title {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--gold-lt);
      margin-bottom: .8rem;
    }

    .cq-q {
      font-size: .9rem;
      color: #ccc;
      margin-bottom: .6rem;
      line-height: 1.5;
    }

    .cq-opts {
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }

    .cq-opt {
      background: #1e1e1e;
      border: 1.5px solid #333;
      color: #bbb;
      padding: .45rem .9rem;
      font-size: .85rem;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: all .15s;
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .cq-opt:hover:not(:disabled) {
      border-color: var(--gold);
      color: var(--gold);
    }

    .cq-opt.correct {
      border-color: #66bb6a;
      background: #0e2010;
      color: #a5d6a7;
    }

    .cq-opt.wrong {
      border-color: #ef5350;
      background: #2e0a0a;
      color: #ef9a9a;
    }

    .cq-opt:disabled {
      cursor: default;
    }

    .cq-fb {
      display: none;
      margin-top: .6rem;
      font-size: .82rem;
      padding: .45rem .7rem;
    }

    .cq-fb.show {
      display: block;
    }

    .cq-fb.ok {
      background: #0e2010;
      color: #a5d6a7;
      border-left: 3px solid #66bb6a;
    }

    .cq-fb.err {
      background: #2e0a0a;
      color: #ef9a9a;
      border-left: 3px solid #ef5350;
    }

    /* Nav buttons */
    .step-nav {
      display: flex;
      gap: .6rem;
      margin-top: 2rem;
      padding-top: 1.2rem;
      border-top: 1px solid var(--gray2);
    }

    .btn-step {
      padding: .55rem 1.4rem;
      font-size: .82rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      cursor: pointer;
      border: 2px solid transparent;
      font-family: inherit;
      transition: all .15s;
    }

    .btn-step.secondary {
      background: transparent;
      color: #666;
      border-color: var(--gray2);
    }

    .btn-step.secondary:hover {
      border-color: #999;
      color: #333;
    }

    .btn-step.primary {
      background: var(--gold);
      color: var(--black);
      border-color: var(--gold);
    }

    .btn-step.primary:hover {
      background: var(--gold-lt);
    }

    .btn-step.launch {
      background: var(--green);
      color: white;
      border-color: var(--green);
      font-size: .9rem;
      padding: .7rem 2rem;
    }

    .btn-step.launch:hover {
      background: var(--green-lt);
    }

    /* Progress indicator inside card */
    .card-progress {
      display: flex;
      gap: 4px;
      margin-bottom: 1.4rem;
    }

    .cp-dot {
      height: 4px;
      flex: 1;
      background: var(--gray2);
      transition: background .3s;
    }

    .cp-dot.done {
      background: var(--step-done);
    }

    .cp-dot.active {
      background: var(--gold);
    }

    /* ═══════════════════════════════════════
   LAB SCREEN (original layout, upgraded)
═══════════════════════════════════════ */
    #labScreen {
      display: none;
    }

    /* RUN PROGRESS */
    .prog {
      background: var(--black);
      padding: .65rem 1.4rem;
      display: flex;
      align-items: center;
      gap: .8rem;
      flex-wrap: wrap;
      border-bottom: 2px solid #1e1e1e;
    }

    .prog-lbl {
      color: var(--gold);
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .dots {
      display: flex;
      gap: 5px;
    }

    .dot {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #1e1e1e;
      border: 2px solid #333;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .7rem;
      font-weight: 700;
      color: #555;
      cursor: pointer;
      transition: all .2s;
      font-family: 'JetBrains Mono', monospace;
    }

    .dot.active {
      background: var(--gold);
      border-color: var(--gold);
      color: var(--black);
    }

    .dot.done {
      background: var(--step-done);
      border-color: var(--step-done);
      color: #fff;
    }

    .hdr-score {
      margin-left: auto;
      color: #aaa;
      font-size: .78rem;
      font-family: 'JetBrains Mono', monospace;
    }

    /* MAIN GRID */
    .main {
      display: grid;
      grid-template-columns: 1fr 390px;
      min-height: calc(100vh - 130px);
    }

    /* LEFT: BEAKER PANEL */
    .bpanel {
      background: #fff;
      padding: 1.2rem 1.4rem .8rem;
      border-right: 1px solid var(--gray2);
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .run-hdr {
      display: flex;
      align-items: baseline;
      gap: .75rem;
      margin-bottom: .7rem;
    }

    .run-badge {
      background: var(--gold);
      color: var(--black);
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: .7rem;
      padding: 3px 10px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .run-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
    }

    .eq-line {
      font-size: .78rem;
      color: #555;
      padding: .35rem .7rem;
      background: #f9f9f9;
      border-left: 3px solid var(--gold);
      margin-bottom: .7rem;
      font-family: 'JetBrains Mono', monospace;
    }

    .svg-wrap {
      flex: 1;
    }

    .svg-wrap svg {
      width: 100%;
      height: auto;
      display: block;
    }

    /* RIGHT: Q&A PANEL */
    .qpanel {
      background: var(--black);
      color: #fff;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      max-height: calc(100vh - 130px);
      position: sticky;
      top: 0;
    }

    .qinner {
      padding: 1.1rem 1.2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0;
      flex: 1;
    }

    .q-intro {
      font-size: .65rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: .9rem;
      line-height: 1.5;
    }

    .qa-sec {
      margin-bottom: 1rem;
      border-left: 4px solid #2d2d2d;
      padding-left: .8rem;
      transition: border-color .3s;
    }

    .qa-sec.active {
      border-left-color: var(--gold);
    }

    .qa-sec.done {
      border-left-color: var(--step-done);
    }

    .qa-lbl {
      font-size: .63rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--gold);
      margin-bottom: .28rem;
    }

    .qa-lbl.done {
      color: #81c784;
    }

    .qa-q {
      font-size: .84rem;
      color: #ccc;
      margin-bottom: .4rem;
      line-height: 1.45;
    }

    .qa-row {
      display: flex;
      gap: .4rem;
      align-items: center;
      flex-wrap: wrap;
    }

    select {
      background: #1e1e1e;
      color: #eee;
      border: 2px solid #444;
      padding: .36rem .6rem;
      font-size: .86rem;
      font-family: inherit;
      flex: 1;
      min-width: 155px;
      transition: border-color .2s;
    }

    select:focus {
      outline: none;
      border-color: var(--gold);
    }

    select.ok {
      border-color: #66bb6a;
      background: #0e2010;
    }

    select.err {
      border-color: #ef5350;
      background: #2e0a0a;
    }

    .btn-chk {
      background: var(--gold);
      color: var(--black);
      border: none;
      padding: .38rem .8rem;
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .05em;
      text-transform: uppercase;
      cursor: pointer;
      font-family: inherit;
    }

    .btn-chk:hover {
      background: var(--gold-lt);
    }

    .fb {
      display: none;
      margin-top: .3rem;
      font-size: .79rem;
      line-height: 1.4;
      padding: .38rem .6rem;
      border-left: 3px solid transparent;
    }

    .fb.show {
      display: block;
    }

    .fb.ok {
      background: #0e2010;
      color: #a5d6a7;
      border-color: #66bb6a;
    }

    .fb.err {
      background: #2e0a0a;
      color: #ef9a9a;
      border-color: #ef5350;
    }

    .divider {
      border: none;
      border-top: 1px solid #2a2a2a;
      margin: .75rem 0;
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: .28rem;
      margin: .22rem 0 .45rem;
    }

    .chip {
      background: #1e1e1e;
      border: 1px solid #444;
      color: var(--gold-lt);
      font-size: .74rem;
      font-weight: 600;
      padding: 2px 8px;
      letter-spacing: .03em;
    }

    .nav-btns {
      display: flex;
      gap: .4rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .btn-nav {
      background: #1e1e1e;
      color: #ccc;
      border: 2px solid #333;
      padding: .4rem .95rem;
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .15s;
      font-family: inherit;
    }

