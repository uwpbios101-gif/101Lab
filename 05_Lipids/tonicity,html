      g('iH2O').textContent = r.inH2O + '% H₂O';
      g('oNaCl').textContent = r.outNaCl + '% NaCl';
      g('iNaCl').textContent = r.inNaCl + '% NaCl';

      // H2O arrows
      const oH2OArr = h2oVal === 'outside' ? '↑' : h2oVal === 'inside' ? '↓' : h2oVal === 'equal' ? '＝' : '';
      const iH2OArr = h2oVal === 'outside' ? '↓' : h2oVal === 'inside' ? '↑' : h2oVal === 'equal' ? '＝' : '';
      g('oH2Oa').textContent = oH2OArr;
      g('iH2Oa').textContent = iH2OArr;

      // NaCl arrows
      const oNaClArr = naclVal === 'outside' ? '↑' : naclVal === 'inside' ? '↓' : naclVal === 'equal' ? '＝' : '';
      const iNaClArr = naclVal === 'outside' ? '↓' : naclVal === 'inside' ? '↑' : naclVal === 'equal' ? '＝' : '';
      g('oNaCla').textContent = oNaClArr;
      g('iNaCla').textContent = iNaClArr;

      // Osmosis arrow
      if (dirVal && dirVal !== '') {
        g('osmosisG').setAttribute('display', 'block');
        if (dirVal === 'out_to_in') {
          g('osmosisLine').setAttribute('x1', '450'); g('osmosisLine').setAttribute('y1', '185');
          g('osmosisLine').setAttribute('x2', '450'); g('osmosisLine').setAttribute('y2', '325');
          g('osmosisLbl').textContent = 'H₂O →';
          g('osmosisLbl').setAttribute('y', '175');
        } else if (dirVal === 'in_to_out') {
          g('osmosisLine').setAttribute('x1', '450'); g('osmosisLine').setAttribute('y1', '325');
          g('osmosisLine').setAttribute('x2', '450'); g('osmosisLine').setAttribute('y2', '185');
          g('osmosisLbl').textContent = '← H₂O';
          g('osmosisLbl').setAttribute('y', '175');
        } else {
          g('osmosisLine').setAttribute('x1', '450'); g('osmosisLine').setAttribute('y1', '255');
          g('osmosisLine').setAttribute('x2', '450'); g('osmosisLine').setAttribute('y2', '255');
          g('osmosisLbl').textContent = 'H₂O ＝';
          g('osmosisLbl').setAttribute('y', '245');
        }
      } else {
        g('osmosisG').setAttribute('display', 'none');
      }

      // Animate cell fill for direction
      const fill = g('cellWaterFill');
      if (dirVal === 'out_to_in') {
        fill.setAttribute('height', '80'); fill.setAttribute('y', '368');
      } else if (dirVal === 'in_to_out') {
        fill.setAttribute('height', '0'); fill.setAttribute('y', '448');
      } else {
        fill.setAttribute('height', '40'); fill.setAttribute('y', '408');
      }
    }

    /* ═══════════════════════════════════════
       CHECK / SCORING
    ═══════════════════════════════════════ */
    function check(field) {
      const r = RUNS[currentRun];
      const sel = g({ h2o: 'sel_h2o', nacl: 'sel_nacl', dir: 'sel_dir', cue: 'sel_cue', tout: 'sel_tout', tin: 'sel_tin', out: 'sel_out' }[field]);
      if (!sel || !sel.value) return;
      const ok = sel.value === r.ans[field];
      const key = currentRun + '_' + field;
      if (!scored[key]) { if (ok) { score++; updateScore(); } scored[key] = true; }
      sel.className = ok ? 'ok' : 'err';
      showFb(field, ok, mkFb(field, r, ok));
      if (ok) { confirmed[currentRun][field] = sel.value; markDone(field); checkNext(); }
      if (ok && (field === 'tout' || field === 'tin')) showPill(field, r);
      if (ok && field === 'out') showOutcome(r);
      liveUpdate();
    }

    function showPill(field, r) {
      const isOut = field === 'tout';
      const tRect = isOut ? g('oTonRect') : g('iTonRect');
      const tLbl = isOut ? g('oTonicLbl') : g('iTonicLbl');
      const val = isOut ? r.ans.tout : r.ans.tin;
      const colors = { hypo: '#1a4e8c', hyper: '#c0392b', isotonic: '#1b6b2f' };
      const col = colors[val] || '#555';
      const tw = val.length * 9 + 10;
      tRect.setAttribute('width', tw); tRect.setAttribute('fill', col);
      tRect.setAttribute('display', 'block');
      tLbl.textContent = val; tLbl.setAttribute('display', 'block');
    }

    function hidePill(rId, lId) {
      g(rId).setAttribute('display', 'none'); g(rId).setAttribute('width', '0');
      g(lId).setAttribute('display', 'none');
    }

    function showOutcome(r) {
      const colors = {
        lyse: '#c0392b', normal: '#1b6b2f', shrivel: '#7a3b0a',
        turgid: '#1b6b2f', flaccid: '#7a5c00', plasmolyzed: '#6a1b9a'
      };
      g('outBadge').setAttribute('display', 'block');
      g('outRect').setAttribute('fill', colors[r.ans.out] || '#555');
      g('outWord').textContent = r.ans.out.toUpperCase();

      const cellEl = g('svgCell');
      if (r.ans.out === 'lyse') {
        cellEl.setAttribute('display', 'none');
        g('svgCellBurst').setAttribute('display', 'block');
        g('plasmoGroup').setAttribute('display', 'none');
      } else if (r.ans.out === 'shrivel') {
        cellEl.setAttribute('rx', '110'); cellEl.setAttribute('ry', '80');
        g('svgCellBurst').setAttribute('display', 'none');
        g('plasmoGroup').setAttribute('display', 'none');
      } else if (r.ans.out === 'turgid') {
        cellEl.setAttribute('rx', '158'); cellEl.setAttribute('ry', '118');
        g('svgCellBurst').setAttribute('display', 'none');
        g('plasmoGroup').setAttribute('display', 'none');
      } else if (r.ans.out === 'plasmolyzed') {
        cellEl.setAttribute('display', 'none');
        g('plasmoGroup').setAttribute('display', 'block');
        g('svgCellBurst').setAttribute('display', 'none');
      } else {
        cellEl.setAttribute('rx', '148'); cellEl.setAttribute('ry', '108');
        g('svgCellBurst').setAttribute('display', 'none');
        g('plasmoGroup').setAttribute('display', 'none');
      }
    }

    function mkFb(field, r, ok) {
      const isEqual = r.ans.nacl === 'equal';
      const outNaClArrow = r.ans.nacl === 'outside' ? '↑' : r.ans.nacl === 'inside' ? '↓' : '＝';
      const inNaClArrow = r.ans.nacl === 'inside' ? '↑' : r.ans.nacl === 'outside' ? '↓' : '＝';
      const msgs = {
        nacl: ok ? `✓ Correct! Outside ${r.outNaCl}% NaCl vs Inside ${r.inNaCl}% NaCl — solute arrows now on diagram.`
          : `✗ Compare: Outside ${r.outNaCl}% NaCl vs Inside ${r.inNaCl}% NaCl. Which number is larger?`,
        h2o: ok ? `✓ Correct! Outside ${r.outH2O}% H₂O vs Inside ${r.inH2O}% — note how H₂O is the inverse of NaCl.`
          : `✗ Remember: NaCl + H₂O = 100%. If NaCl is higher on one side, H₂O must be lower on that same side.`,
        dir: ok ? `✓ Correct! Water moves toward higher NaCl (lower H₂O). Watch the cell ${r.ans.dir === 'out_to_in' ? 'fill with water' : 'lose water'}.`
          : `✗ Water moves toward MORE NaCl. Look at your NaCl arrows — which side has the ↑?`,
        cue: isEqual
          ? (ok ? `✓ Correct! Equal NaCl on both sides (＝) = isotonic — no net water movement.`
            : `✗ Look at the NaCl arrows — both show ＝ meaning equal on both sides. That means isotonic.`)
          : (ok ? `✓ Correct! ↓ NaCl = hypo (less solute) · ↑ NaCl = hyper (more solute). Lock this in!`
            : `✗ ↓ means LESS NaCl = hypo. ↑ means MORE NaCl = hyper. Look at your NaCl arrows on the diagram.`),
        tout: ok ? `✓ Correct! Outside NaCl arrow (${outNaClArrow}) → ${r.ans.tout}. Label now on diagram.`
          : `✗ Look at the outside NaCl arrow (${outNaClArrow}). Use your cue: ↓ = hypo · ↑ = hyper · ＝ = isotonic.`,
        tin: ok ? `✓ Correct! Inside NaCl arrow (${inNaClArrow}) → ${r.ans.tin}. Label now on diagram.`
          : `✗ Look at the inside NaCl arrow (${inNaClArrow}). Use your cue: ↓ = hypo · ↑ = hyper · ＝ = isotonic.`,
        out: ok ? `✓ ${EXPLAIN[r.ans.out]}`
          : `✗ Water moved ${r.ans.dir === 'out_to_in' ? 'INTO' : 'OUT OF'} the cell. What happens to a ${r.cellType} cell in that case?`
      };
      return msgs[field] || '';
    }

    function showFb(field, ok, msg) {
      const ids = { h2o: 'fb_h2o', nacl: 'fb_nacl', dir: 'fb_dir', cue: 'fb_cue', tout: 'fb_tout', tin: 'fb_tin', out: 'fb_out' };
      const el = g(ids[field]);
      if (!el) return;
      el.className = 'fb show ' + (ok ? 'ok' : 'err');
      el.textContent = msg;
    }

    function markDone(field) {
      const sm = { h2o: 'sec_h2o', nacl: 'sec_nacl', dir: 'sec_dir', cue: 'sec_cue', tout: 'sec_tout', tin: 'sec_tin', out: 'sec_out' };
      const lm = { h2o: 'lbl_h2o', nacl: 'lbl_nacl', dir: 'lbl_dir', cue: 'lbl_cue', tout: 'lbl_tout', tin: 'lbl_tin', out: 'lbl_out' };
      if (g(sm[field])) g(sm[field]).className = 'qa-sec done';
      if (g(lm[field])) g(lm[field]).className = 'qa-lbl done';
    }

    function checkNext() {
      const c = confirmed[currentRun];
      const allDone = c.h2o && c.nacl && c.dir && c.cue && c.tout && c.tin && c.out;
      g('btnNext').disabled = !allDone;
      if (allDone) setDot(currentRun, 'done');
    }

    function updateScore() {
      const s = '<strong style="color:var(--gold)">' + score + '</strong>';
      g('scoreNum').textContent = score;
      if (g('hdrScore')) g('hdrScore').innerHTML = 'Score: ' + s + ' / 42';
      if (g('hdrScore2')) g('hdrScore2').innerHTML = 'Score: ' + s + ' / 42';
    }

    /* ═══════════════════════════════════════
       NAVIGATION
    ═══════════════════════════════════════ */
    function advanceRun() {
      if (currentRun < 5) goRun(currentRun + 1);
      else finishLab();
    }

    function goRun(idx) {
      if (idx < 0 || idx > 5) return;
      currentRun = idx;
      const r = RUNS[idx];
      const conf = confirmed[idx];

      g('runBadge').textContent = r.label;
      g('runTitle').textContent = r.title;

      const isPlant = r.cellType === 'plant';
      g('svgCellType').textContent = isPlant ? 'Plant Cell' : 'Animal Cell';
      g('svgCellWall').setAttribute('display', isPlant ? 'block' : 'none');
      const cellEl = g('svgCell');
      cellEl.setAttribute('fill', isPlant ? '#d4edda' : 'white');
      cellEl.setAttribute('stroke', isPlant ? '#2e7d32' : '#111');
      cellEl.setAttribute('stroke-width', isPlant ? '4' : '3.5');

      const sm = { h2o: 'sec_h2o', nacl: 'sec_nacl', dir: 'sec_dir', cue: 'sec_cue', tout: 'sec_tout', tin: 'sec_tin', out: 'sec_out' };
      const lm = { h2o: 'lbl_h2o', nacl: 'lbl_nacl', dir: 'lbl_dir', cue: 'lbl_cue', tout: 'lbl_tout', tin: 'lbl_tin', out: 'lbl_out' };
      const ss = { h2o: 'sel_h2o', nacl: 'sel_nacl', dir: 'sel_dir', cue: 'sel_cue', tout: 'sel_tout', tin: 'sel_tin', out: 'sel_out' };
      const fs = { h2o: 'fb_h2o', nacl: 'fb_nacl', dir: 'fb_dir', cue: 'fb_cue', tout: 'fb_tout', tin: 'fb_tin', out: 'fb_out' };
      const fields = ['nacl', 'h2o', 'dir', 'cue', 'tout', 'tin', 'out'];

      fields.forEach((f, i) => {
        const sec = g(sm[f]); const lbl = g(lm[f]);
        const sel = g(ss[f]); const fb = g(fs[f]);
        if (conf[f]) {
          sec.className = 'qa-sec done';
          lbl.className = 'qa-lbl done';
          sel.value = conf[f]; sel.className = 'ok';
          fb.className = 'fb show ok';
          fb.textContent = mkFb(f, r, true);
        } else {
          sec.className = 'qa-sec' + (i === 0 ? ' active' : '');
          lbl.className = 'qa-lbl';
          sel.value = ''; sel.className = '';
          fb.className = 'fb'; fb.textContent = '';
        }
      });

      const wb = g('wordBank');
      wb.innerHTML = '';
      r.words.forEach(w => {
        const chip = document.createElement('span');
        chip.className = 'chip'; chip.textContent = w;
        wb.appendChild(chip);
      });
      const outSel = g('sel_out');
      outSel.innerHTML = '<option value="">— select —</option>';
      r.words.forEach(w => {
        const o = document.createElement('option');
        o.value = w; o.textContent = w; outSel.appendChild(o);
      });
      if (conf.out) { outSel.value = conf.out; outSel.className = 'ok'; }

      g('svgCell').setAttribute('rx', '148'); g('svgCell').setAttribute('ry', '108');
      g('svgCell').setAttribute('display', 'block');
      g('svgCellBurst').setAttribute('display', 'none');
      g('plasmoGroup').setAttribute('display', 'none');
      g('cellClipEl').setAttribute('rx', '146'); g('cellClipEl').setAttribute('ry', '106');
      g('svgCellWall').setAttribute('rx', '157'); g('svgCellWall').setAttribute('ry', '117');
      const fill = g('cellWaterFill');
      fill.setAttribute('height', '0'); fill.setAttribute('y', '448');
      fill.setAttribute('clip-path', 'url(#cellClip)'); fill.setAttribute('opacity', '0.4');
      g('outBadge').setAttribute('display', 'none');
      hidePill('oTonRect', 'oTonicLbl');
      hidePill('iTonRect', 'iTonicLbl');

      g('btnPrev').disabled = (idx === 0);
      g('btnNext').disabled = !conf.out;

      for (let i = 0; i < 6; i++) {
        setDot(i, i === idx ? 'active' : (confirmed[i].out ? 'done' : ''));
      }

      liveUpdate();
    }

    function setDot(i, state) {
      const labels = ['A1', 'A2', 'A3', 'P1', 'P2', 'P3'];
      const d = g('dot' + i);
      d.className = 'dot' + (state === 'active' ? ' active' : state === 'done' ? ' done' : '');
      d.textContent = state === 'done' ? '✓' : labels[i];
    }

    function finishLab() {
      g('mainLayout').style.display = 'none';
      g('finishBanner').className = 'finish show';
      g('finalScore').textContent = score + ' / 42';
    }

    function resetAll() {
      score = 0; scored = {};
      confirmed = Array.from({ length: 6 }, () => ({}));
      g('mainLayout').style.display = '';
      g('finishBanner').className = 'finish';
      updateScore();
      goRun(0);
    }
  </script>
</body>

</html>
