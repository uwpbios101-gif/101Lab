    function goStep(n) {
      // Mark current as done
      stepsDone[currentStep] = true;
      document.getElementById('card' + currentStep).classList.remove('active');
      document.getElementById('sb' + currentStep).classList.remove('active');
      document.getElementById('sb' + currentStep).classList.add('done');

      currentStep = n;
      document.getElementById('card' + n).classList.add('active');

      // Update sidebar
      for (let i = 0; i < totalSteps; i++) {
        const sb = document.getElementById('sb' + i);
        sb.classList.remove('active', 'done');
        if (i === n) sb.classList.add('active');
        else if (stepsDone[i]) sb.classList.add('done');
      }

      // Scroll to top of content
      document.querySelector('.prelab-content').scrollTo({ top: 0, behavior: 'smooth' });
    }

    function answerQuiz(stepNum, btn, correct) {
      const opts = btn.parentElement.querySelectorAll('.cq-opt');
      opts.forEach(o => { o.disabled = true; });
